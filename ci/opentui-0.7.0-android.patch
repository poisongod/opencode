+fn addAndroidCMacros(translate: *std.Build.Step.TranslateC) void {
+    translate.defineCMacro("__ANDROID_API__", "24");
+    translate.defineCMacro("__ANDROID_MIN_SDK_VERSION__", "24");
+    // Bionic headers annotate array parameters with Clang nullability.
+    translate.defineCMacro("_Nullable", "");
+    translate.defineCMacro("_Nonnull", "");
+    translate.defineCMacro("_Null_unspecified", "");
+    translate.defineCMacro("_Nullable_result", "");
+}
